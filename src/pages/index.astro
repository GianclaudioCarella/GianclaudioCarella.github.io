---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const works = (await getCollection('works'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: new URL(withBase('/'), site).href,
  jobTitle: 'Software engineer',
  email: 'gianclaudio.gc@gmail.com',
  sameAs: [
    'https://github.com/GianclaudioCarella',
    'https://www.linkedin.com/in/gianclaudiocarella/',
  ],
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={[websiteSchema, personSchema]} />
  <section class="hero section">
    <p class="eyebrow">Software engineer · backend · AI</p>
    <h1>Gianclaudio Moura Carella</h1>
    <p class="lead">
      I design and build backend services and cloud-native systems, and I work on AI agents and
      conversational products. Based in Barcelona.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/works/')}>{t('home.viewWorks')}</a>
      <a class="text-link" href={withBase('/about/')}>{t('nav.about')}</a>
    </div>
  </section>

  <section class="section split-overview" aria-label={t('home.overviewLabel')}>
    <div>
      <p class="eyebrow">Focus</p>
      <h2>Backend systems, cloud architecture, and applied AI.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Backend and APIs</h3>
        <p>
          Scalable, secure services with an emphasis on clean design, testing, and long-term
          maintainability.
        </p>
      </article>
      <article>
        <h3>Cloud-native delivery</h3>
        <p>
          Infrastructure and CI/CD for reliable systems, including work on Microsoft Azure,
          Terraform, Docker, and Kubernetes.
        </p>
      </article>
      <article>
        <h3>AI platforms</h3>
        <p>
          Self-hosted agents and the practical work of putting conversational products on the web.
        </p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestWorksEyebrow')}</p>
      <h2 id="latest-works">Selected work.</h2>
      <a class="text-link" href={withBase('/works/')}>{t('home.allWorks')}</a>
    </div>

    {
      works.length > 0 ? (
        <div class="highlight-grid">
          {works.map((work) => (
            <article class="highlight-card">
              {work.data.thumbnail && (
                <Image src={work.data.thumbnail} alt="" width={720} height={480} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(work.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
                </h3>
                <p>{work.data.description}</p>
                {work.data.tech.length > 0 && (
                  <ul class="tag-list" aria-label={t('home.workTech', { title: work.data.title })}>
                    {work.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.worksEmpty')} />
        </div>
      )
    }
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-notes">Writing.</h2>
      <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              {post.data.heroImage && (
                <Image src={post.data.heroImage} alt="" width={320} height={220} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(post.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>
